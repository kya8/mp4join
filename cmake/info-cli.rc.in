#include <Winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GIT_VERSION_MAJOR@,@GIT_VERSION_MINOR@,@GIT_VERSION_PATCH@,@GIT_VERSION_BUILD@
 PRODUCTVERSION @GIT_VERSION_MAJOR@,@GIT_VERSION_MINOR@,@GIT_VERSION_PATCH@,@GIT_VERSION_BUILD@
 FILEFLAGSMASK 0x3f
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0" /* US English, Unicode codepage */
    BEGIN
      //VALUE "CompanyName",      "\0"
      VALUE "FileDescription",  "mp4join command line app\0"
      VALUE "FileVersion",      "@GIT_DESC@\0"
      VALUE "InternalName",     "mp4join\0"
      VALUE "LegalCopyright",   "kya8, 2025, The MIT license\0"
      VALUE "OriginalFilename", "mp4join.exe\0"
      VALUE "ProductName",      "mp4join\0"
      VALUE "ProductVersion",   "@GIT_DESC@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
